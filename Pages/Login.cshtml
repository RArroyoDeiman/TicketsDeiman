@page
@model TicketsDeiman.Pages.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>

    <!-- CSS -->
    <link href="~/css/login.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&display=swap" rel="stylesheet">

</head>
<body>
    <div class="container text-center">

        <div class="title-text">TICKETS</div>

        <div class="bubble-wrapper mx-auto">
            <!-- Círculo central con logo -->
            <div class="logo-circle" id="logoCircle">
                <img src="~/imagenes/logotipo_blanco.png" alt="Logo" class="logo-image" />
            </div>

            <!-- Círculos de colores estilo Game Center -->
            <div class="bubble bubble-1"></div>
            <div class="bubble bubble-2"></div>
            <div class="bubble bubble-3"></div>
            <div class="bubble bubble-4"></div>
            <div class="bubble bubble-5"></div>
            <div class="bubble bubble-6"></div>
        </div>

        <form method="post" class="mx-auto" style="max-width: 400px;">
            @* Validación general del modelo *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3 text-start">
                <input asp-for="Input.Username" class="form-control" placeholder="Usuario" />
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>

            <div class="mb-3 text-start">
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="Contraseña" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div>
                <button type="submit" class="btn btn-primary w-50 mb-3" id="loginButton">Iniciar Sesión</button>
            </div>
            <a href="#" class="forgot-password">¿Olvidó su contraseña?</a>
        </form>
    </div>

    <!-- JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.13/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/login.js"></script>
</body>
</html>



